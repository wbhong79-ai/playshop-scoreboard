rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 누구나 읽기 가능, 점수 입력용 공용 계정으로 로그인한 사람만 쓰기 가능
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "playshop-scorer@example.com";
    }
  }
}
